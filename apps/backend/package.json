{
  "name": "@fsolution/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "start:dev": "nodemon --watch src --ext ts --exec \"npm run start\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:pg": "node prisma/migrate.js",
    "db:start": "node scripts/db-start.js",
    "db:stop": "node scripts/db-stop.js",
    "db:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:seed:accounts": "ts-node -r tsconfig-paths/register prisma/seed-accounts.ts"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.2.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.2.0",
    "@nestjs/swagger": "^7.3.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "joi": "^17.13.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "16.14.0-beta.17",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^6.19.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
